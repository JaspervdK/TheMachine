[Unit]
Description=The Machine browser: viewer entry proxy (exits after 15 idle minutes, which stops the browser)
Requires=machine-browser-view.socket machine-browser-novnc.service machine-browser-chrome.service
After=machine-browser-view.socket machine-browser-novnc.service machine-browser-chrome.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=15min 127.0.0.1:6081
